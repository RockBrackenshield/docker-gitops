# Installed by host/bootstrap.sh to /etc/systemd/system/.
# Loads the raw PREROUTING (and, on core, INPUT) rules before the network and
# Docker come up. RequiredBy=docker.service: if this unit fails (for example
# an invalid /etc/homelab/firewall.env), Docker does not start (fails closed).
# RequiredBy=nfs-server.service does the same for host NFS on core, which does
# not depend on Docker (on infrastructure, which has no nfs-server, the link
# is inert).
# Never `systemctl restart` this unit: Requires= would restart Docker (and
# nfs-server) too.
# To re-apply, run `/usr/local/sbin/homelab-firewall.sh --early` directly.
[Unit]
Description=homelab firewall, raw/INPUT rules (before network and Docker)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target docker.service nfs-server.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/homelab-firewall.sh --early

[Install]
RequiredBy=docker.service nfs-server.service
WantedBy=multi-user.target
