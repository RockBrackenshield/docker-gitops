# CI-only placeholder values for `docker compose config` in
# .github/workflows/compose-validate.yml. Never deployed: real values come
# from Dockhand (Bitwarden Secrets Manager) at deploy time.
# Addresses are RFC 5737 documentation addresses (TEST-NET), not real hosts.
# Only add a variable here if `docker compose config` fails without it.

# compose/core/paperless: host_ip must parse as an IP address
CORE_LAN_IP=192.0.2.10
# compose/core/paperless: Samba hosts allow
SMB_HOSTS_ALLOW=192.0.2.20
